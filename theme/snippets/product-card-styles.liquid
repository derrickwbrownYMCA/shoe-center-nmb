{% comment %}
  Shared product-card styles for collection and search templates.
  Frameless presentation (Yellow Box pattern): product floats on white,
  swatch dots differentiate, minimal anatomy, no per-card buttons.
{% endcomment %}

<style>
  .product-card {
    position: relative; /* anchor for the stretched title link */
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
  }

  /* ── Media: frameless, product floats on white ─────────────────────── */
  .product-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #FFFFFF;
    border-radius: 4px;
  }

  .product-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 0.35s ease;
  }

  .product-card:hover .product-card__img { transform: scale(1.03); }

  .product-card__img--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-card__placeholder-svg {
    width: 60%;
    fill: var(--color-border, #C8C8C8);
  }

  .product-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--color-accent, #F5E1E1);
    color: var(--color-heading, #000000);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .product-card__badge--dark {
    background: var(--color-heading, #000000);
    color: var(--color-bg, #FAF9F6);
  }

  /* ── Body: swatches → title → price ────────────────────────────────── */
  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 2px 4px;
  }

  .product-card__swatches {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 16px;
  }

  .product-card__dot {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.14);
    /* Zoom into the center of the variant photo so the shoe's color,
       not the white studio background, fills the dot. */
    background-size: 470%;
    background-position: 50% 42%;
    background-repeat: no-repeat;
    background-color: #EDEAE4;
  }

  .product-card__dot--hex { background-size: auto; }

  .product-card__dot-more {
    color: var(--color-text-secondary, #6B7378);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  /* Screen-reader-only color count (dots themselves are aria-hidden) */
  .product-card__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .product-card__title {
    margin: 0;
    color: var(--color-heading, #000000);
    font-family: var(--font-heading, sans-serif);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  /* Stretched link: covers the whole card so everything is clickable,
     while the title remains the single real <a> for accessibility. */
  .product-card__link {
    color: inherit;
    text-decoration: none;
  }

  .product-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 6px;
  }

  .product-card__link:focus-visible {
    outline: none; /* focus is drawn on the card-covering ::after instead */
  }

  .product-card__link:focus-visible::after {
    outline: 3px solid #005FCC;
    outline-offset: 2px;
  }

  .product-card:hover .product-card__link { opacity: 0.75; }

  .product-card__prices,
  .product-card__prices .price__row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }

  .product-card__prices .price__current {
    color: var(--color-heading, #000000);
    font-size: 14px;
    font-weight: 600;
  }

  .product-card__prices .price__current--sale { color: #A7473E; }
  .product-card__prices .price__compare { color: var(--color-text-secondary, #6B7378); font-size: 12px; text-decoration: line-through; }

  @media (max-width: 599px) {
    .product-card__body { padding: 10px 2px 2px; gap: 7px; }
    .product-card__title { font-size: 14px; }
    .product-card__dot { width: 13px; height: 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card__img { transition: none; }
    .product-card:hover .product-card__img { transform: none; }
  }
</style>
