{% comment %}
  sections/featured-products.liquid
  ──────────────────────────────────────────────────────────────────────────────
  New Arrivals / Featured Products grid — a collection-driven product showcase
  that sits below the category tiles on the homepage.

  ARCHITECTURE
  ─────────────
  The section reads products from a merchant-selected collection and renders
  them in a responsive CSS Grid. Product cards come from the shared
  snippets/product-card.liquid + product-card-styles.liquid (same anatomy as
  the collection and search grids: frameless image → swatch dots → short
  name → price, whole card is the link). Only the section chrome (header,
  grid, View All link, empty-state placeholders) lives here.

  EMPTY STATE
  ────────────
  When no collection is selected (new install, Theme Editor), Shopify's built-in
  placeholder_svg_tag renders clean gray SVG silhouettes so the section never
  looks broken. The number of placeholders matches `products_to_show`.

  ACCESSIBILITY
  ──────────────
  • <section aria-labelledby> + <h2 id> for landmark naming
  • Product cards are <li> inside <ul role="list"> — correct list semantics
  • Badge text is included in the aria-label on the card link
  • :focus-visible ring on every interactive element
{% endcomment %}

{%- liquid
  assign fp_collection    = collections[section.settings.collection]
  assign products_limit   = section.settings.products_to_show | default: 8
  assign desktop_cols     = section.settings.columns_desktop   | default: '4'

  # Section surface. Frameless product photos (P1) merge with a WHITE
  # surface, so 'card' now maps to #FFFFFF; 'bg' keeps the site cream.
  assign section_bg = section.settings.background | default: 'card'
  if section_bg == 'bg'
    assign section_bg_value = 'var(--color-bg, #FAF9F6)'
  else
    assign section_bg_value = '#FFFFFF'
  endif

  # Determine heading tag level — h2 is correct for a homepage section heading
  assign heading_id = 'FeaturedHeading-' | append: section.id
-%}

{%- render 'product-card-styles' -%}

<section
  class="featured-products section-padding"
  style="background-color: {{ section_bg_value }};"
  aria-labelledby="{{ heading_id }}"
>
  <div class="container">

    <!-- ── Section header ──────────────────────────────────────────────── -->
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="featured-products__header">

        {%- if section.settings.heading != blank -%}
          <h2
            class="featured-products__heading"
            id="{{ heading_id }}"
          >
            {{- section.settings.heading | escape -}}
          </h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="featured-products__subheading">
            {{- section.settings.subheading | escape -}}
          </p>
        {%- endif -%}

      </header>
    {%- endif -%}

    <!-- ── Product grid ────────────────────────────────────────────────── -->
    <ul
      class="featured-products__grid"
      role="list"
      style="--fp-cols: {{ desktop_cols }};"
    >

      {%- if fp_collection != blank and fp_collection.products != blank and fp_collection.products.size > 0 -%}

        {%- comment -%}
          Cards come from the shared snippet (same anatomy as collection and
          search grids): frameless image → swatch dots → short name → price.
          Badge logic, placeholders, and pricing all live in the snippet.
        {%- endcomment -%}
        {%- for product in fp_collection.products limit: products_limit -%}
          <li class="featured-products__item">
            {%- render 'product-card',
              product: product,
              show_badges: true,
              lazy_load: true,
              strip_vendor: true
            -%}
          </li>
        {%- endfor -%}

      {%- else -%}

        {%- comment -%}
          No collection selected or collection is empty.
          Renders Shopify SVG placeholder cards equal to the configured limit.
          These look intentional in the Theme Editor rather than a blank section.
        {%- endcomment -%}
        {%- for i in (1..products_limit) -%}
          <li class="featured-products__item">
            <article class="product-card product-card--placeholder" aria-label="Example product">
              <div class="product-card__media">
                <div class="product-card__img product-card__img--placeholder">
                  {%- comment -%} Shopify only ships product-1..product-6 — cycle within that range {%- endcomment -%}
                  {%- assign fp_ph2 = i | minus: 1 | modulo: 6 | plus: 1 -%}
                  {{- 'product-' | append: fp_ph2 | placeholder_svg_tag: 'product-card__placeholder-svg' -}}
                </div>
              </div>
              <div class="product-card__body">
                <h3 class="product-card__title">
                  <span class="product-card__link">Product Title</span>
                </h3>
                <div class="product-card__prices">
                  <span class="price__current">$0.00</span>
                </div>
              </div>
            </article>
          </li>
        {%- endfor -%}

      {%- endif -%}

    </ul><!-- /.featured-products__grid -->

    <!-- ── "View All" footer CTA ─────────────────────────────────────── -->
    {%- if section.settings.show_view_all -%}
      {%- assign view_all_url = section.settings.view_all_url -%}
      {%- if view_all_url == blank -%}
        {%- if fp_collection -%}
          {%- assign view_all_url = fp_collection.url -%}
        {%- else -%}
          {%- assign view_all_url = routes.collections_url -%}
        {%- endif -%}
      {%- endif -%}

      <div class="featured-products__footer">
        <a href="{{ view_all_url }}" class="featured-products__view-all-btn">
          {{- section.settings.view_all_text | default: 'View All New Arrivals' | escape -}}
        </a>
      </div>
    {%- endif -%}

  </div><!-- /.container -->
</section>

<style>
  /* ── Section ─────────────────────────────────────────────────────────── */
  .featured-products {
    /* White product band on the cream homepage — hairline rules top and
       bottom mark it as the page's single deliberate surface change. */
    border-top: 1px solid rgba(24, 36, 46, 0.08);
    border-bottom: 1px solid rgba(24, 36, 46, 0.08);
  }

  /* ── Section header ──────────────────────────────────────────────────── */
  .featured-products__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    margin-bottom: 56px;
  }

  .featured-products__heading {
    font-family: var(--font-heading, sans-serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: clamp(24px, 3vw, 38px);
    letter-spacing: var(--heading-letter-spacing, 0.06em);
    color: var(--color-heading, #000000);
    margin: 0;
    line-height: 1.1;
  }

  .featured-products__subheading {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(15px, 1.4vw, 17px);
    color: var(--color-text-secondary, #A8A8A8);
    max-width: 520px;
    margin: 0;
    line-height: 1.65;
  }

  /* ── Grid ────────────────────────────────────────────────────────────── */
  .featured-products__grid {
    display: grid;
    /*
      --fp-cols is set inline from the schema select (3 or 4).
      Defaults to 4 if the property is absent.
    */
    grid-template-columns: repeat(var(--fp-cols, 4), 1fr);
    gap: 32px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .featured-products__item {
    list-style: none;
    /*
      display: flex + min-width: 0 lets cards stretch to equal height
      within the row, which keeps the "View All" CTA button pinned to
      the bottom of every card regardless of title length.
    */
    display: flex;
  }

  /* ── Card ─────────────────────────────────────────────────────────────
    Card markup and styles come from snippets/product-card.liquid and
    snippets/product-card-styles.liquid — single source shared with the
    collection and search grids. Only the empty-state placeholder styling
    is local to this section.
  ─────────────────────────────────────────────────────────────────────── */
  .product-card--placeholder {
    pointer-events: none;
    opacity: 0.65;
  }

  .product-card--placeholder .product-card__link {
    color: var(--color-border, #A8A8A8);
  }

  .product-card__placeholder-svg {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    fill: #C8C8C8;
    padding: 20px;
  }


  /* ── "View All" footer ────────────────────────────────────────────── */
  .featured-products__footer {
    display: flex;
    justify-content: center;
    margin-top: 56px;
  }

  /*
    "View All" — demoted from a button to an underlined text link (P6:
    buttons only where action happens; this CTA only navigates to a
    collection). Quiet by design so the card CTAs keep the visual weight.
  */
  .featured-products__view-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: none;
    border: none;
    border-radius: 0;
    color: inherit;
    font-family: var(--font-body, sans-serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
    line-height: 1.4;
    cursor: pointer;
    transition: opacity var(--transition, 0.2s ease);
  }

  .featured-products__view-all-btn:hover {
    opacity: 0.72;
  }

  .featured-products__view-all-btn:focus-visible {
    outline: 3px solid #005FCC;
    outline-offset: 3px;
  }

  /* ── Responsive ───────────────────────────────────────────────────── */

  /*
    Tablet: cap at 2 columns to prevent tiny cramped tiles.
    A 4-column grid at 768px gives each card ~170px — too narrow for any
    product image to look good.
  */
  @media (max-width: 1023px) {
    .featured-products__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }

    .featured-products__header {
      margin-bottom: 36px;
    }
  }

  /* Mobile: 2 columns with comfortable spacing. Card-internal responsive
     rules live in snippets/product-card-styles.liquid. */
  @media (max-width: 599px) {
    .featured-products__grid {
      gap: 14px;
    }

    .featured-products__footer {
      margin-top: 40px;
    }
  }
</style>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "class": "featured-products-section",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals",
      "info": "Displayed as an H2. Keep it short — 1–3 words works best."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Fresh comfort styles just in — shoes that make every step feel good.",
      "info": "Optional. Appears below the heading in muted text."
    },

    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Choose which collection to pull products from. 'New Arrivals' or 'Featured' collections work well here."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 8,
      "info": "Shows up to this many products from the selected collection. Even numbers keep the grid balanced."
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "options": [
        { "value": "3", "label": "3 columns — larger cards" },
        { "value": "4", "label": "4 columns — standard (recommended)" }
      ],
      "default": "4",
      "info": "Mobile always shows 2 columns."
    },
    {
      "type": "text",
      "id": "card_cta_text",
      "label": "Card button text",
      "default": "Shop Now",
      "info": "Label on the blush button inside each product card."
    },

    {
      "type": "header",
      "content": "View All button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View All\" button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Button label",
      "default": "View All New Arrivals"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Button link",
      "info": "Defaults to the selected collection URL if left blank."
    },

    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background color",
      "options": [
        { "value": "bg",   "label": "Cream — same as page background" },
        { "value": "card", "label": "Light grey — visually distinct band (recommended)" }
      ],
      "default": "card",
      "info": "Light grey creates a subtle visual break between cream sections above and below."
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "settings": {
        "heading": "New Arrivals",
        "subheading": "Fresh comfort styles just in — shoes that make every step feel good.",
        "products_to_show": 8,
        "columns_desktop": "4",
        "card_cta_text": "Shop Now",
        "show_view_all": true,
        "view_all_text": "View All New Arrivals",
        "background": "card"
      }
    }
  ]
}
{% endschema %}

