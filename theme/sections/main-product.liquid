{% comment %}
  sections/main-product.liquid
  ─────────────────────────────────────────────────────────────────────────────
  Product Detail Page (PDP) — clean two-column layout.

  Left:  Product image gallery (main + thumbnail strip)
  Right: Vendor · Title · Price · Variant options · Qty · Add to Cart · Description

  Custom elements used:
    <variant-selector> — detects option changes, finds matching variant
    <product-form>     — intercepts submit, calls CartAPI, opens drawer

  The <script type="application/json" data-variant-json> block embeds all
  variant data so VariantSelector can find matches without extra fetches.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign section_id      = section.id
  assign show_vendor     = section.settings.show_vendor
  assign show_qty        = section.settings.show_quantity_input
  assign show_desc       = section.settings.show_description
  assign requires_size_selection = false
  assign has_explicit_variant = false
  assign vendor_downcase = product.vendor | downcase | strip
  assign is_in_store_only = false

  if product.selected_variant != blank
    assign has_explicit_variant = true
  endif

  if has_explicit_variant == false and product.featured_image != blank
    for product_variant in product.variants
      if product_variant.available and product_variant.featured_image.id == product.featured_image.id
        assign current_variant = product_variant
        break
      endif
    endfor
  endif

  assign size_option_index = -1
  for product_option in product.options_with_values
    assign product_option_name = product_option.name | downcase
    if product_option_name contains 'size'
      assign requires_size_selection = true
      assign size_option_index = forloop.index0
    endif
  endfor

  # Selected value per option position, used by the variant-button UI to
  # mark availability. The size slot stays blank until the shopper picks
  # one — mirrors the "Select a size" placeholder logic on the selects.
  assign sel_value_0 = current_variant.options[0]
  assign sel_value_1 = current_variant.options[1]
  assign sel_value_2 = current_variant.options[2]
  if has_explicit_variant == false
    if size_option_index == 0
      assign sel_value_0 = ''
    elsif size_option_index == 1
      assign sel_value_1 = ''
    elsif size_option_index == 2
      assign sel_value_2 = ''
    endif
  endif

  # Shared by the main buy form and the sticky purchase bar (form= attribute)
  assign product_form_id = 'ProductForm-' | append: section_id

  if vendor_downcase == 'new balance'
    assign is_in_store_only = true
  endif

  assign featured_product_image = current_variant.featured_image | default: product.featured_image
  if product.handle == 'vaneli-paris' and has_explicit_variant == false and product.images.size > 1
    assign featured_product_image = product.images[1]
  endif
  assign featured_product_image_index = 1
  for gallery_image in product.images
    if gallery_image.id == featured_product_image.id
      assign featured_product_image_index = forloop.index
    endif
  endfor
  assign featured_product_image_alt = featured_product_image.alt | default: product.title
  assign featured_product_image_alt = featured_product_image_alt | append: ' — product view ' | append: featured_product_image_index | append: ' of ' | append: product.images.size

  # Which option is Color? The gallery filters thumbnails to the selected
  # color's media (JS reads data-color-option-index off .product-gallery).
  assign color_option_index = -1
  for gallery_opt in product.options_with_values
    assign gallery_opt_dn = gallery_opt.name | downcase
    if gallery_opt_dn == 'color'
      assign color_option_index = forloop.index0
    endif
  endfor
-%}

<section
  class="main-product section-padding"
  id="MainProduct-{{ section_id }}"
  data-section-id="{{ section_id }}"
>
  <nav class="product-breadcrumbs container" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    {%- assign breadcrumb_collection = collection | default: product.collections.first -%}
    {%- if breadcrumb_collection != blank -%}
      <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title | escape }}</a>
      <span aria-hidden="true">/</span>
    {%- endif -%}
    <span aria-current="page">{{ product.title | escape }}</span>
  </nav>
  <div class="container main-product__layout">

    <!-- ── Left: Image gallery ──────────────────────────────────────────── -->
    <div class="product-gallery" aria-label="Product images" data-color-option-index="{{ color_option_index }}">

      <!-- Main image -->
      <div class="product-gallery__main">
        {%- if featured_product_image != blank -%}
          <button
            class="product-gallery__zoom-trigger"
            type="button"
            aria-label="Open larger product image"
            data-image-src="{{ featured_product_image | image_url: width: 2000 }}"
            data-image-alt="{{ featured_product_image_alt | escape }}"
          >
            {{
              featured_product_image
              | image_url: width: 1200
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                class: 'product-gallery__main-img js-main-product-img',
                alt: featured_product_image_alt,
                width: featured_product_image.width,
                height: featured_product_image.height,
                widths: '600, 800, 1000, 1200',
                sizes: '(max-width: 767px) calc(100vw - 32px), (max-width: 1023px) 50vw, calc(min(100vw, 1280px) / 2 - 80px)'
            }}
            <span class="product-gallery__zoom-hint" aria-hidden="true">View larger</span>
          </button>
        {%- else -%}
          <div class="product-gallery__main-img product-gallery__main-img--placeholder">
            {{- 'product-1' | placeholder_svg_tag: 'product-gallery__placeholder-svg' -}}
          </div>
        {%- endif -%}
      </div>

      <!-- Thumbnail strip -->
      {%- if product.images.size > 1 -%}
        <div class="product-gallery__thumbs" role="list" aria-label="Product image thumbnails">
          {%- for image in product.images -%}
            {%- liquid
              assign gallery_image_alt = image.alt | default: product.title
              assign gallery_image_alt = gallery_image_alt | append: ' — product view ' | append: forloop.index | append: ' of ' | append: product.images.size

              # Color for this image: variant image binding first, then the
              # alt convention "<Title> in <ColorA> | <ColorB>" set by the
              # upload pipeline. Unmatched images get an empty key and are
              # shown for every color (graceful fallback).
              assign gallery_image_color = ''
              if color_option_index > -1
                for gallery_pv in product.variants
                  if gallery_image_color == '' and gallery_pv.featured_image.id == image.id
                    assign gallery_image_color = gallery_pv.options[color_option_index]
                  endif
                endfor
                if gallery_image_color == '' and image.alt contains ' in '
                  assign gallery_image_color = image.alt | split: ' in ' | last | strip
                endif
              endif
              assign gallery_image_color_key = gallery_image_color | downcase | replace: ' ', '' | replace: '/', '' | replace: '|', '' | replace: '-', '' | replace: '_', '' | replace: ',', ''
            -%}
            <button
              class="product-gallery__thumb{% if image.id == featured_product_image.id %} is-active{% endif %}"
              role="listitem"
              data-image-id="{{ image.id }}"
              data-image-src="{{ image | image_url: width: 1200 }}"
              data-image-full-src="{{ image | image_url: width: 2000 }}"
              data-image-alt="{{ gallery_image_alt | escape }}"
              data-color-key="{{ gallery_image_color_key }}"
              aria-label="View image {{ forloop.index }} of {{ product.images.size }}"
              tabindex="0"
              type="button"
            >
              {{
                image
                | image_url: width: 160
                | image_tag:
                  loading: 'lazy',
                  decoding: 'async',
                  class: 'product-gallery__thumb-img',
                  alt: gallery_image_alt,
                  width: image.width,
                  height: image.height
              }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if featured_product_image != blank -%}
        <dialog class="product-gallery__lightbox" aria-label="Larger product image">
          <form method="dialog">
            <button class="product-gallery__lightbox-close" type="submit" aria-label="Close larger image">×</button>
          </form>
          <figure class="product-gallery__lightbox-figure">
            <img
              class="product-gallery__lightbox-img"
              src="{{ featured_product_image | image_url: width: 2000 }}"
              alt="{{ featured_product_image_alt | escape }}"
              width="{{ featured_product_image.width }}"
              height="{{ featured_product_image.height }}"
            >
            <figcaption class="product-gallery__lightbox-caption">{{ featured_product_image_alt | escape }}</figcaption>
          </figure>
        </dialog>
      {%- endif -%}

    </div><!-- /.product-gallery -->

    <!-- ── Right: Product info ──────────────────────────────────────────── -->
    <div class="product-info">

      {%- if show_vendor and product.vendor != blank -%}
        <a
          href="{{ product.vendor | url_for_vendor }}"
          class="product-info__vendor"
        >
          {{- product.vendor | escape -}}
        </a>
      {%- endif -%}

      <h1 class="product-info__title">{{ product.title | escape }}</h1>

      <!-- Price (updated dynamically on variant change via JS) -->
      <div class="product-info__price js-variant-price">
        {%- render 'price', product: product, variant: current_variant -%}
      </div>

      <!-- Variant options -->
      {%- unless product.has_only_default_variant -%}
        <variant-selector
          class="product-info__variants"
          data-section-id="{{ section_id }}"
          data-url="{{ product.url }}"
        >
          {%- for option in product.options_with_values -%}
            {%- liquid
              # Gender-aware size label: if a product is tagged as women's but the
              # WooCommerce option name imported as "US Men's Size", correct it —
              # and vice versa. The form name attribute keeps the original option
              # name so Shopify's variant lookup still works.
              assign display_option_name = option.name
              assign current_option_value = current_variant.options[forloop.index0]
              assign option_name_downcase = option.name | downcase
              assign is_size_option = false
              if option_name_downcase contains 'size'
                assign is_size_option = true
              endif
              if option.name == "US Men's Size"
                if product.tags contains "Women's Shoes" or product.tags contains "womens" or product.tags contains "women" or product.type == "Women's Shoes"
                  assign display_option_name = "US Women's Size"
                endif
              elsif option.name == "US Women's Size"
                if product.tags contains "Men's Shoes" or product.tags contains "mens" or product.tags contains "men" or product.type == "Men's Shoes"
                  assign display_option_name = "US Men's Size"
                endif
              endif
            -%}
            <div class="product-info__option">
              <label
                class="product-info__option-label"
                for="Option-{{ section_id }}-{{ forloop.index0 }}"
              >
                {{ display_option_name | escape }}
              </label>
              <select
                id="Option-{{ section_id }}-{{ forloop.index0 }}"
                name="options[{{ option.name | escape }}]"
                class="product-info__option-select"
                data-option-index="{{ forloop.index0 }}"
                {% if is_size_option %}data-required-option="true" required{% endif %}
                aria-label="{{ display_option_name | escape }}"
              >
                {%- if is_size_option and has_explicit_variant == false -%}
                  <option value="" selected disabled>Select a size</option>
                {%- endif -%}
                {%- for value in option.values -%}
                  <option
                    value="{{ value | escape }}"
                    {% if current_option_value == value and is_size_option == false or current_option_value == value and has_explicit_variant %}selected{% endif %}
                  >
                    {{- value | escape -}}
                  </option>
                {%- endfor -%}
              </select>

              {%- comment -%}
                Variant buttons — progressive enhancement over the select.
                Buttons write to the hidden select and dispatch 'change', so
                VariantSelector remains the single source of truth (price,
                URL, gallery filtering all keep working unchanged). CSS shows
                the buttons and hides the select only after the inline script
                adds .variant-buttons-ready — no-JS shoppers keep the select.
                Availability marks reflect the other currently-selected
                options; the inline script re-computes them on every change.
              {%- endcomment -%}
              {%- liquid
                assign option_index = forloop.index0
                assign is_width_option = false
                if option_name_downcase contains 'width'
                  assign is_width_option = true
                endif
              -%}
              <div
                class="variant-btns{% if is_width_option %} variant-btns--segmented{% endif %}"
                data-option-buttons
                data-option-index="{{ option_index }}"
                role="group"
                aria-label="{{ display_option_name | escape }}"
              >
                {%- for value in option.values -%}
                  {%- liquid
                    assign is_value_selected = false
                    if current_option_value == value
                      if is_size_option == false or has_explicit_variant
                        assign is_value_selected = true
                      endif
                    endif

                    assign value_is_available = false
                    for availability_variant in product.variants
                      unless availability_variant.available
                        continue
                      endunless
                      if availability_variant.options[option_index] != value
                        continue
                      endif
                      if option_index != 0 and sel_value_0 != blank and availability_variant.options[0] != sel_value_0
                        continue
                      endif
                      if option_index != 1 and sel_value_1 != blank and availability_variant.options[1] != sel_value_1
                        continue
                      endif
                      if option_index != 2 and sel_value_2 != blank and availability_variant.options[2] != sel_value_2
                        continue
                      endif
                      assign value_is_available = true
                      break
                    endfor
                  -%}
                  <button
                    type="button"
                    class="variant-btn{% unless value_is_available %} is-unavailable{% endunless %}"
                    data-value="{{ value | escape }}"
                    aria-pressed="{% if is_value_selected %}true{% else %}false{% endif %}"
                  >
                    {{- value | escape -}}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          {%- comment -%}
            Embed all variant data as JSON for VariantSelector custom element.
            Placed inside <variant-selector> so the element can find it easily.
          {%- endcomment -%}
          <script type="application/json" data-variant-json>
            {{ product.variants | json }}
          </script>

        </variant-selector>
        <p class="product-info__media-note" role="status"{% if has_explicit_variant == false or current_variant.featured_image != blank %} hidden{% endif %}>
          A photo for this color is coming soon. Please call <a href="tel:+18432726515">(843) 272-6515</a> if you would like help before ordering.
        </p>
      {%- endunless -%}

      <!-- Add to Cart form -->
      <product-form>
        {%- form 'product', product, id: product_form_id, novalidate: 'novalidate' -%}

          <input
            type="hidden"
            name="id"
            id="ProductVariantId-{{ section_id }}"
            value="{% if requires_size_selection and has_explicit_variant == false %}{% else %}{{ current_variant.id }}{% endif %}"
          >

          {%- if show_qty -%}
            <div class="product-info__qty-row">
              <label class="product-info__qty-label" for="Qty-{{ section_id }}">
                Quantity
              </label>
              <div class="product-info__qty-stepper">
                <button
                  class="product-info__qty-btn"
                  type="button"
                  data-qty-down="{{ section_id }}"
                  aria-label="Decrease quantity"
                >−</button>
                <input
                  class="product-info__qty-input"
                  type="number"
                  id="Qty-{{ section_id }}"
                  name="quantity"
                  value="1"
                  min="1"
                  data-qty-target="{{ section_id }}"
                  aria-label="Quantity"
                >
                <button
                  class="product-info__qty-btn"
                  type="button"
                  data-qty-up="{{ section_id }}"
                  aria-label="Increase quantity"
                >+</button>
              </div>
            </div>
          {%- else -%}
            <input type="hidden" name="quantity" value="1">
          {%- endif -%}

          {%- if is_in_store_only -%}
            <a
              class="btn btn--full product-info__add-btn product-info__store-only-btn"
              href="tel:+18432726515"
            >
              Call for New Balance Availability
            </a>
            <p class="product-info__form-note">New Balance is available for purchase in our North Myrtle Beach store only.</p>
          {%- elsif requires_size_selection and has_explicit_variant == false -%}
            <button
              class="btn btn--cta btn--full product-info__add-btn js-add-to-cart"
              type="submit"
              name="add"
              data-add-text="Add to Cart"
              disabled
              aria-disabled="true"
            >
              Choose a Size
            </button>
          {%- elsif current_variant.available -%}
            <button
              class="btn btn--cta btn--full product-info__add-btn js-add-to-cart"
              type="submit"
              name="add"
              data-add-text="Add to Cart"
            >
              Add to Cart
            </button>
          {%- else -%}
            <button
              class="btn btn--cta btn--full product-info__add-btn"
              type="submit"
              disabled
              aria-disabled="true"
            >
              Sold Out
            </button>
          {%- endif -%}

        {%- endform -%}
      </product-form>

      {%- comment -%}
        Compact 2×2 trust grid — one line per point, ≤8 words, linked to the
        relevant policy or tel:. Full policy sentences live in the
        "Shipping, Pickup & Returns" accordion below the description.
      {%- endcomment -%}
      <ul class="product-info__trust" aria-label="Shopping reassurance">
        <li class="product-info__trust-item">
          <svg class="product-info__trust-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9l1-5h16l1 5"/><path d="M4 9v11a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9"/><path d="M9 21v-6h6v6"/></svg>
          <a href="/pages/contact">Buy online, pick up in store</a>
        </li>
        <li class="product-info__trust-item">
          <svg class="product-info__trust-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="1" y="5" width="14" height="12" rx="1"/><path d="M15 9h4l3 4v4h-7"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg>
          <a href="{{ shop.shipping_policy.url | default: '/pages/contact' }}">$7.95 shipping — free at $200+</a>
        </li>
        <li class="product-info__trust-item">
          <svg class="product-info__trust-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="9 14 4 9 9 4"/><path d="M4 9h11a5 5 0 0 1 5 5v0a5 5 0 0 1-5 5H8"/></svg>
          <a href="{{ shop.refund_policy.url }}">14-day store credit returns</a>
        </li>
        <li class="product-info__trust-item">
          <svg class="product-info__trust-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <a href="tel:+18432726515">Fit help: (843) 272-6515</a>
        </li>
      </ul>

      <!-- Description accordion -->
      {%- if show_desc and product.description != blank -%}
        <details class="product-info__details" open>
          <summary class="product-info__details-trigger">
            <span>Product Details</span>
            <svg class="product-info__details-icon" xmlns="http://www.w3.org/2000/svg"
              width="18" height="18" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true" focusable="false">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="product-info__description rte">
            {{ product.description }}
          </div>
        </details>
      {%- endif -%}

      <!-- Shipping, pickup & returns accordion — full policy language -->
      <details class="product-info__details">
        <summary class="product-info__details-trigger">
          <span>Shipping, Pickup &amp; Returns</span>
          <svg class="product-info__details-icon" xmlns="http://www.w3.org/2000/svg"
            width="18" height="18" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true" focusable="false">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </summary>
        <div class="product-info__description rte">
          <p><strong>In-store pickup.</strong> Buy online, then pick up at our North Myrtle Beach store — orders are usually ready within 2 hours.</p>
          <p><strong>Simple shipping.</strong> $7.95 shipping under $200; free standard shipping on orders of $200 or more.</p>
          <p><strong>14-day store credit.</strong> Unworn merchandise may be returned for store credit. <a href="{{ shop.refund_policy.url }}">Read the policy</a>.</p>
          <p><strong>Need fit help?</strong> Call <a href="tel:+18432726515">(843) 272-6515</a> for personal guidance before you order.</p>
        </div>
      </details>

    </div><!-- /.product-info -->

  </div><!-- /.main-product__layout -->

  {%- comment -%}
    Sticky purchase bar — mobile only (CSS-gated at 767px). The button
    submits the main product form via its form="" attribute, so
    ProductForm's submit interception (required-size guard, cart drawer)
    applies unchanged. State mirrors the main button by listening to the
    same variant:change event; shown/hidden by an IntersectionObserver
    watching the buy box in the inline script below.
  {%- endcomment -%}
  <div class="pdp-sticky" data-pdp-sticky hidden>
    {%- if featured_product_image != blank -%}
      <img
        class="pdp-sticky__thumb"
        src="{{ featured_product_image | image_url: width: 96 }}"
        alt=""
        width="48"
        height="48"
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      >
    {%- endif -%}
    <div class="pdp-sticky__info">
      <span class="pdp-sticky__title">{{ product.title | escape }}</span>
      <span class="pdp-sticky__meta" data-sticky-meta>
        {%- unless product.has_only_default_variant or has_explicit_variant == false -%}
          {{ current_variant.title | replace: ' / ', ' · ' | escape }} ·
        {%- endunless %}
        {{ current_variant.price | money }}
      </span>
    </div>
    {%- if is_in_store_only -%}
      <a class="btn pdp-sticky__btn" href="tel:+18432726515">Call the Store</a>
    {%- elsif requires_size_selection and has_explicit_variant == false -%}
      <button
        class="btn btn--cta pdp-sticky__btn"
        type="submit"
        name="add"
        form="{{ product_form_id }}"
        data-sticky-add
        data-add-text="Add to Cart"
        disabled
        aria-disabled="true"
      >Choose a Size</button>
    {%- elsif current_variant.available -%}
      <button
        class="btn btn--cta pdp-sticky__btn"
        type="submit"
        name="add"
        form="{{ product_form_id }}"
        data-sticky-add
        data-add-text="Add to Cart"
      >Add to Cart</button>
    {%- else -%}
      <button
        class="btn btn--cta pdp-sticky__btn"
        type="submit"
        form="{{ product_form_id }}"
        data-sticky-add
        data-add-text="Add to Cart"
        disabled
        aria-disabled="true"
      >Sold Out</button>
    {%- endif -%}
  </div>
</section>

<!-- ── JSON-LD Structured Data ──────────────────────────────────────────── -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "url": {{ canonical_url | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  "image": [
    {%- for image in product.images limit: 5 -%}
      {{ image | image_url: width: 800 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "offers": [
    {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "availability": "{%- if variant.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}",
        "sku": {{ variant.sku | json }},
        "url": {{ canonical_url | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

