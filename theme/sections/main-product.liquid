<script>
  /* Variant buttons + sticky purchase bar — scoped to this section.
     The buttons are a thin input layer over the hidden <select>s, so
     VariantSelector (theme.js) keeps owning variant matching, price,
     URL state, and gallery filtering. The sticky bar mirrors buy-state
     from the same variant:change event rather than watching the DOM. */
  (() => {
    const section = document.getElementById('MainProduct-{{ section_id }}');
    if (!section) return;

    const selector = section.querySelector('variant-selector');
    const selects = selector ? Array.from(selector.querySelectorAll('select')) : [];
    let variants = [];
    try {
      variants = JSON.parse(selector?.querySelector('[data-variant-json]')?.textContent || '[]');
    } catch { variants = []; }

    /* ── Variant buttons ── */
    if (selector && selects.length) {
      selector.classList.add('variant-buttons-ready');
      const groups = Array.from(selector.querySelectorAll('[data-option-buttons]'));

      const refresh = () => {
        const sel = selects.map(s => s.value);
        groups.forEach(group => {
          const idx = parseInt(group.dataset.optionIndex, 10);
          group.querySelectorAll('.variant-btn').forEach(btn => {
            btn.setAttribute('aria-pressed', String(sel[idx] === btn.dataset.value));
            const available = variants.some(v =>
              v.available &&
              v.options[idx] === btn.dataset.value &&
              v.options.every((opt, j) => j === idx || !sel[j] || opt === sel[j])
            );
            btn.classList.toggle('is-unavailable', !available);
          });
        });
      };

      groups.forEach(group => {
        group.addEventListener('click', e => {
          const btn = e.target.closest('.variant-btn');
          if (!btn) return;
          const idx = parseInt(group.dataset.optionIndex, 10);
          const select = selects.find(s => parseInt(s.dataset.optionIndex, 10) === idx);
          if (!select || select.value === btn.dataset.value) return;
          select.value = btn.dataset.value;
          select.dispatchEvent(new Event('change', { bubbles: true }));
        });
      });

      document.addEventListener('variant:change', e => {
        if (section.contains(e.target)) refresh();
      });
      refresh();
    }

    /* ── Sticky purchase bar ── */
    const bar = section.querySelector('[data-pdp-sticky]');
    const buyBox = section.querySelector('product-form');
    if (bar && buyBox && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        /* Show only once the buy box has scrolled up out of view */
        bar.hidden = entry.isIntersecting || entry.boundingClientRect.top > 0;
      }, { threshold: 0 }).observe(buyBox);

      const stickyBtn = bar.querySelector('[data-sticky-add]');
      const stickyMeta = bar.querySelector('[data-sticky-meta]');
      if (stickyBtn) {
        document.addEventListener('variant:change', e => {
          if (!section.contains(e.target)) return;
          const { variant, incomplete } = e.detail;
          const setDisabled = (disabled, label) => {
            stickyBtn.disabled = disabled;
            if (disabled) stickyBtn.setAttribute('aria-disabled', 'true');
            else stickyBtn.removeAttribute('aria-disabled');
            stickyBtn.textContent = label;
          };
          if (incomplete) setDisabled(true, 'Choose a Size');
          else if (!variant) setDisabled(true, 'Unavailable');
          else if (!variant.available) setDisabled(true, 'Sold Out');
          else setDisabled(false, stickyBtn.dataset.addText || 'Add to Cart');

          if (stickyMeta && variant) {
            const price = (typeof formatMoney === 'function') ? formatMoney(variant.price) : '';
            const title = variant.title && variant.title !== 'Default Title'
              ? variant.title.split(' / ').join(' · ')
              : '';
            stickyMeta.textContent = [title, price].filter(Boolean).join(' · ');
          }
        });
      }
    }
  })();
</script>

